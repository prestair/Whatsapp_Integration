# Optional Supabase control plane for the local WhatsApp worker
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Leave WORKER_ID unset — each computer auto-generates a stable unique id (worker.json).
# CONTROL_PLANE_WORKER_ID=
# Friendly device name shown on the shared dashboard:
CONTROL_PLANE_WORKER_NAME=My Device
CONTROL_PLANE_POLL_MS=5000
MONITOR_LEASE_MS=45000

# Comma-separated browser origins allowed to call the local API.
# Example: https://your-project.vercel.app,http://localhost:3000
CORS_ORIGIN=http://localhost:3000
